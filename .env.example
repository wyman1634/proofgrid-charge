# Fuji release: set these in your shell or the deployment platform's secret manager.
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# For CI only. Locally prefer `npm run deploy:fuji:keychain`, which reuses the
# encrypted Fuji keystore and macOS Keychain password from the earlier bootcamp task.
FUJI_DEPLOYER_PRIVATE_KEY=0x
FUJI_KEYSTORE_ENV_PATH=/absolute/path/to/encrypted/fuji-keystore.env
FUJI_KEYCHAIN_SERVICE=your-fuji-deployer
FUJI_KEYCHAIN_ACCOUNT=your-account
PROOFGRID_ATTESTOR_PRIVATE_KEY=0x
FUJI_CHARGING_OPERATOR_ADDRESS=0x
FUJI_ATTESTOR_URL=https://your-attestor.example.com
FUJI_CONTRACT_ADDRESS=0x
# Optional. Defaults to a timestamped, unique Session ID for an isolated smoke run.
FUJI_SMOKE_SESSION_ID=fuji-smoke-001
FUJI_STATION_ID=station-fuji-001
FUJI_TARIFF_WEI_PER_WH=1000
